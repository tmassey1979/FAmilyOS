<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FamilyOS.Maui.Controls"
             x:Class="FamilyOS.Maui.Pages.DesignSystemGalleryPage"
             Title="Design system">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource ThicknessPage}" Spacing="24">

            <Label Text="FamilyOS design system" Style="{StaticResource TextTitle}" />
            <Label Text="Component gallery — theme tokens and shared controls."
                   Style="{StaticResource TextCaption}" />

            <controls:FoSectionTitle Text="Theme" />
            <HorizontalStackLayout Spacing="8">
                <controls:FoButton Title="System" Variant="Secondary" Clicked="OnThemeSystem" />
                <controls:FoButton Title="Light" Variant="Secondary" Clicked="OnThemeLight" />
                <controls:FoButton Title="Dark" Variant="Secondary" Clicked="OnThemeDark" />
            </HorizontalStackLayout>

            <controls:FoSectionTitle Text="Buttons" />
            <controls:FoButton Title="Primary action" Variant="Primary" />
            <controls:FoButton Title="Secondary" Variant="Secondary" />
            <controls:FoButton Title="Danger" Variant="Danger" />
            <controls:FoButton Title="Ghost" Variant="Ghost" />
            <controls:FoButton Title="Loading" Variant="Primary" IsLoading="True" />

            <controls:FoSectionTitle Text="Badges" />
            <HorizontalStackLayout Spacing="8">
                <controls:FoBadge Text="Neutral" Tone="Neutral" />
                <controls:FoBadge Text="Info" Tone="Info" />
                <controls:FoBadge Text="Success" Tone="Success" />
                <controls:FoBadge Text="Warning" Tone="Warning" />
                <controls:FoBadge Text="Danger" Tone="Danger" />
            </HorizontalStackLayout>

            <controls:FoSectionTitle Text="Card + list" />
            <controls:FoCard>
                <VerticalStackLayout Spacing="8">
                    <controls:FoListRow Title="Evening chores" Subtitle="Assigned to Mia" />
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtle}}" />
                    <controls:FoListRow Title="Grocery run" Subtitle="Pending approval" />
                </VerticalStackLayout>
            </controls:FoCard>

            <controls:FoSectionTitle Text="Form" />
            <controls:FoTextField Label="Display name" Placeholder="Terry" HelperText="Shown to your household" />
            <controls:FoTextField Label="Invite code" IsError="True" HelperText="Code expired or already used" />

            <controls:FoSectionTitle Text="Status" />
            <controls:FoStatusBanner Kind="Info" Message="New invite waiting for acceptance." />
            <controls:FoStatusBanner Kind="Offline" Message="You’re offline. Changes will sync when connected." />
            <controls:FoStatusBanner Kind="Danger" Message="Could not reach the API." />

            <controls:FoSectionTitle Text="Empty / loading / error" />
            <controls:FoCard>
                <controls:FoEmptyState Title="No tasks yet" Subtitle="Create a task or wait for an assignment." />
            </controls:FoCard>
            <controls:FoCard>
                <controls:FoLoadingView Message="Loading household…" />
            </controls:FoCard>
            <controls:FoCard>
                <controls:FoErrorView Message="We couldn’t load Pulse." />
            </controls:FoCard>

            <controls:FoSectionTitle Text="Chips + avatar" />
            <HorizontalStackLayout Spacing="8">
                <controls:FoChip Text="All" Tone="Neutral" IsSelected="True" />
                <controls:FoChip Text="Tasks" Tone="Info" />
                <controls:FoChip Text="Done" Tone="Success" />
                <controls:FoChip Text="Blocked" Tone="Danger" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="12">
                <controls:FoAvatar Initials="TM" />
                <controls:FoAvatar Initials="MA" Size="48" />
                <controls:FoAvatar Initials="K" Size="32" />
            </HorizontalStackLayout>

            <controls:FoSectionTitle Text="App bar" />
            <controls:FoAppBar Title="Household" Subtitle="Henderson family" ShowLeading="True" />
            <controls:FoAppBar Title="Settings" />

            <controls:FoSectionTitle Text="Dialog (inline preview)" />
            <Border Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtle}}"
                    StrokeThickness="1"
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BgSurfaceAlt}, Dark={StaticResource BgSurfaceAlt}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Label Text="Preview — host FoDialog full-screen when presenting"
                           Style="{StaticResource TextCaption}" />
                    <controls:FoCard>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Approve request?" Style="{StaticResource TextTitle}" />
                            <Label Text="Mia asked for $25 for school supplies."
                                   Style="{StaticResource TextBody}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMuted}}" />
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                <controls:FoButton Title="Deny" Variant="Ghost" />
                                <controls:FoButton Title="Approve" Variant="Primary" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </controls:FoCard>
                </VerticalStackLayout>
            </Border>

            <controls:FoSectionTitle Text="Sheet (inline preview)" />
            <Border Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtle}}"
                    StrokeThickness="1"
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BgSurfaceAlt}, Dark={StaticResource BgSurfaceAlt}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Label Text="Preview — host FoSheet full-screen when presenting"
                           Style="{StaticResource TextCaption}" />
                    <Border Padding="20,16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BgSurface}, Dark={StaticResource BgSurface}}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16,16,0,0" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2"
                                     HorizontalOptions="Center"
                                     Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtle}}" />
                            <Label Text="New task" Style="{StaticResource TextTitle}" />
                            <Label Text="Quick add from Pulse" Style="{StaticResource TextCaption}" />
                            <controls:FoTextField Label="Title" Placeholder="Take out recycling" />
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                <controls:FoButton Title="Cancel" Variant="Secondary" />
                                <controls:FoButton Title="Create" Variant="Primary" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <controls:FoSectionTitle Text="Typography" />
            <Label Text="Display" Style="{StaticResource TextDisplay}" />
            <Label Text="Title" Style="{StaticResource TextTitle}" />
            <Label Text="Heading" Style="{StaticResource TextHeading}" />
            <Label Text="Body text for household content." Style="{StaticResource TextBody}" />
            <Label Text="Caption metadata · 2h ago" Style="{StaticResource TextCaption}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
