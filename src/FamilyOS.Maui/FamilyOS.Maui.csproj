<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>FamilyOS.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Family OS</ApplicationTitle>
    <ApplicationId>com.familyos.app</ApplicationId>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">$(VersionPrefix)</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- CI and local build instructions expand generated graphics before project evaluation.
       Do not run the generator from multiple MSBuild hooks; doing so repeats resource mutation
       during Android publish and can invalidate MAUI resource discovery. -->

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.png"
              ForegroundFile="Resources/AppIcon/appicon_foreground.png"
              Color="#0F172A" />
    <MauiSplashScreen Include="Resources/Splash/splash.png"
                      Color="#0F172A"
                      BaseSize="512,512"
                      Resize="true" />
    <!-- Tab icons + in-app brand logos (logo_mark, logo_wordmark*, logo_lockup) -->
    <MauiImage Include="Resources/Images/Menu/*.png" />
    <MauiImage Include="Resources/Images/Brand/*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
  </ItemGroup>

</Project>
