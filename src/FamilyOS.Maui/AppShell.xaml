<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:FamilyOS.Maui.Pages"
       x:Class="FamilyOS.Maui.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="True"
       Shell.BackgroundColor="{StaticResource BgPage}"
       Shell.ForegroundColor="{StaticResource TextPrimary}"
       Shell.TitleColor="{StaticResource TextPrimary}"
       Shell.TabBarBackgroundColor="{StaticResource BgSurface}"
       Shell.TabBarForegroundColor="{StaticResource AccentPrimary}"
       Shell.TabBarUnselectedColor="{StaticResource TextMuted}"
       Shell.TabBarTitleColor="{StaticResource AccentPrimary}">

    <TabBar>
        <Tab Title="Home"
             Icon="menu_home.png"
             Route="home">
            <ShellContent x:Name="HomeShellContent" Title="Pulse"
                          ContentTemplate="{DataTemplate pages:HomePage}" />
        </Tab>
        <Tab Title="Tasks"
             Icon="menu_tasks.png"
             Route="tasks">
            <ShellContent x:Name="TasksShellContent" Title="Tasks"
                          ContentTemplate="{DataTemplate pages:TasksPage}" />
        </Tab>
        <Tab Title="Calendar"
             Icon="menu_calendar.png"
             Route="calendar">
            <ShellContent x:Name="CalendarShellContent" Title="Calendar"
                          ContentTemplate="{DataTemplate pages:CalendarPage}" />
        </Tab>
        <Tab Title="Family"
             Icon="menu_family.png"
             Route="family">
            <ShellContent x:Name="FamilyShellContent" Title="Family"
                          ContentTemplate="{DataTemplate pages:FamilyPage}" />
        </Tab>
        <Tab Title="More"
             Icon="menu_more.png"
             Route="more">
            <ShellContent Title="More"
                          ContentTemplate="{DataTemplate pages:MorePage}" />
        </Tab>
    </TabBar>
</Shell>
