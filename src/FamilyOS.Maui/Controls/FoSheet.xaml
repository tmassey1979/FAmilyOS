<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FamilyOS.Maui.Controls"
             x:Class="FamilyOS.Maui.Controls.FoSheet">
    <!-- Bottom sheet: scrim + surface docked to bottom. Host full-page when presented. -->
    <Grid x:Name="Root" RowDefinitions="*,Auto">
        <BoxView x:Name="Scrim"
                 Grid.RowSpan="2"
                 Color="{AppThemeBinding Light={StaticResource OverlayScrim}, Dark={StaticResource OverlayScrim}}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="Panel"
                Grid.Row="1"
                StrokeThickness="0"
                Padding="20,16,20,24"
                BackgroundColor="{AppThemeBinding Light={StaticResource BgSurface}, Dark={StaticResource BgSurface}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16,16,0,0" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="16">
                <BoxView WidthRequest="40"
                         HeightRequest="4"
                         CornerRadius="2"
                         HorizontalOptions="Center"
                         Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtle}}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label x:Name="TitleLabel" Style="{StaticResource TextTitle}" />
                        <Label x:Name="SubtitleLabel"
                               Style="{StaticResource TextCaption}"
                               IsVisible="False" />
                    </VerticalStackLayout>
                    <controls:FoButton x:Name="CloseButton"
                                       Grid.Column="1"
                                       Title="Close"
                                       Variant="Ghost"
                                       Clicked="OnCloseClicked" />
                </Grid>
                <ContentView x:Name="BodyHost" />
                <HorizontalStackLayout x:Name="ActionsHost"
                                       Spacing="8"
                                       HorizontalOptions="End"
                                       IsVisible="False">
                    <controls:FoButton x:Name="SecondaryButton"
                                       Title="Cancel"
                                       Variant="Secondary"
                                       IsVisible="False"
                                       Clicked="OnSecondaryClicked" />
                    <controls:FoButton x:Name="PrimaryButton"
                                       Title="Done"
                                       Variant="Primary"
                                       IsVisible="False"
                                       Clicked="OnPrimaryClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
