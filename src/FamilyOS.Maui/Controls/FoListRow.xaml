<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FamilyOS.Maui.Controls.FoListRow">
    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48" Padding="0,8" ColumnSpacing="12">
        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
            <Label x:Name="TitleLabel" Style="{StaticResource TextBodyStrong}" />
            <Label x:Name="SubtitleLabel" Style="{StaticResource TextCaption}" IsVisible="False" />
        </VerticalStackLayout>
        <ContentView x:Name="TrailingHost" Grid.Column="1" VerticalOptions="Center" />
    </Grid>
</ContentView>
