<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FamilyOS.Maui.Controls.FoEmptyState">
    <VerticalStackLayout Padding="32" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
        <Label x:Name="TitleLabel" Style="{StaticResource TextHeading}" HorizontalTextAlignment="Center" />
        <Label x:Name="SubtitleLabel" Style="{StaticResource TextCaption}" HorizontalTextAlignment="Center" IsVisible="False" />
        <ContentView x:Name="ActionHost" Margin="0,16,0,0" IsVisible="False" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentView>
