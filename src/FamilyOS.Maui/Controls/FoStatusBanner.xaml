<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FamilyOS.Maui.Controls.FoStatusBanner">
    <Border x:Name="BannerBorder" StrokeThickness="0" Padding="16,12">
        <Label x:Name="MessageLabel" Style="{StaticResource TextBody}"
               TextColor="{AppThemeBinding Light={StaticResource TextOnAccent}, Dark={StaticResource TextOnAccent}}" />
    </Border>
</ContentView>
