<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FamilyOS.Maui.Controls.FoLoadingView">
    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Padding="32">
        <ActivityIndicator IsRunning="True"
                           Color="{AppThemeBinding Light={StaticResource AccentPrimary}, Dark={StaticResource AccentPrimary}}" />
        <Label x:Name="MessageLabel" Style="{StaticResource TextCaption}" HorizontalTextAlignment="Center" Text="Loading…" />
    </VerticalStackLayout>
</ContentView>
