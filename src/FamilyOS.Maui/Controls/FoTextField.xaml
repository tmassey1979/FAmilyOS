<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FamilyOS.Maui.Controls.FoTextField">
    <VerticalStackLayout Spacing="4">
        <Label x:Name="LabelText" Style="{StaticResource TextCaption}" />
        <Border Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtle}}"
                StrokeThickness="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource BgSurface}, Dark={StaticResource BgSurface}}"
                Padding="12,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Entry x:Name="InnerEntry" Style="{StaticResource FoEntryStyle}" TextChanged="OnTextChanged" />
        </Border>
        <Label x:Name="HelperLabel" Style="{StaticResource TextCaption}" IsVisible="False" />
    </VerticalStackLayout>
</ContentView>
