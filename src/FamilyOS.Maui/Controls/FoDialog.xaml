<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FamilyOS.Maui.Controls"
             x:Class="FamilyOS.Maui.Controls.FoDialog">
    <!-- Scrim + centered card. Host in an AbsoluteLayout / Grid overlay when shown. -->
    <Grid x:Name="Root">
        <BoxView x:Name="Scrim"
                 Color="{AppThemeBinding Light={StaticResource OverlayScrim}, Dark={StaticResource OverlayScrim}}"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="Card"
                MaximumWidthRequest="400"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="24"
                Padding="20"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtle}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource BgSurface}, Dark={StaticResource BgSurface}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="16">
                <Label x:Name="TitleLabel" Style="{StaticResource TextTitle}" />
                <Label x:Name="MessageLabel"
                       Style="{StaticResource TextBody}"
                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMuted}}" />
                <ContentView x:Name="BodyHost" IsVisible="False" />
                <HorizontalStackLayout x:Name="ActionsHost"
                                       Spacing="8"
                                       HorizontalOptions="End">
                    <controls:FoButton x:Name="SecondaryButton"
                                       Title="Cancel"
                                       Variant="Ghost"
                                       IsVisible="False"
                                       Clicked="OnSecondaryClicked" />
                    <controls:FoButton x:Name="PrimaryButton"
                                       Title="OK"
                                       Variant="Primary"
                                       Clicked="OnPrimaryClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
