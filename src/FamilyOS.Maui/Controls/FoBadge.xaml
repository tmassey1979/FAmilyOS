<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FamilyOS.Maui.Controls.FoBadge"
             HorizontalOptions="Start">
    <Border x:Name="BadgeBorder" StrokeThickness="0" Padding="8,4">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8" />
        </Border.StrokeShape>
        <Label x:Name="BadgeLabel" Style="{StaticResource TextChip}" />
    </Border>
</ContentView>
