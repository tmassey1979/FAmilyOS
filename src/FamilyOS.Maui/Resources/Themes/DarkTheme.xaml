<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Midnight interface with cool luminous accents; glow is used sparingly. -->
    <Color x:Key="BgPage">#080D1B</Color>
    <Color x:Key="BgSurface">#111B2E</Color>
    <Color x:Key="BgSurfaceAlt">#1B2940</Color>
    <Color x:Key="BgGlow">#102A42</Color>
    <Color x:Key="BorderSubtle">#30445F</Color>
    <Color x:Key="TextPrimary">#F3F7FF</Color>
    <Color x:Key="TextMuted">#9BAFC9</Color>
    <Color x:Key="TextOnAccent">#081321</Color>
    <Color x:Key="AccentPrimary">#55E6FF</Color>
    <Color x:Key="AccentSecondary">#A78BFA</Color>
    <Color x:Key="AccentDanger">#FF718B</Color>
    <Color x:Key="AccentSuccess">#53E6B1</Color>
    <Color x:Key="AccentWarning">#FFC66D</Color>
    <Color x:Key="OverlayScrim">#000000B3</Color>

</ResourceDictionary>
