<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Cool modern light: clean panels + electric cyan -->
    <Color x:Key="BgPage">#EEF2F7</Color>
    <Color x:Key="BgSurface">#FFFFFF</Color>
    <Color x:Key="BgSurfaceAlt">#E2E8F0</Color>
    <Color x:Key="BorderSubtle">#CBD5E1</Color>
    <Color x:Key="BorderAccent">#22D3EE55</Color>
    <Color x:Key="TextPrimary">#0B1220</Color>
    <Color x:Key="TextMuted">#64748B</Color>
    <Color x:Key="TextOnAccent">#041018</Color>
    <Color x:Key="AccentPrimary">#0891B2</Color>
    <Color x:Key="AccentSecondary">#7C3AED</Color>
    <Color x:Key="AccentGlow">#22D3EE</Color>
    <Color x:Key="AccentDanger">#E11D48</Color>
    <Color x:Key="AccentSuccess">#059669</Color>
    <Color x:Key="AccentWarning">#D97706</Color>
    <Color x:Key="OverlayScrim">#00000066</Color>

</ResourceDictionary>
