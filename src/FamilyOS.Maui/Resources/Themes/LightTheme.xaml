<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- A cool, high-clarity light mode that keeps the same brand character. -->
    <Color x:Key="BgPage">#F4F7FC</Color>
    <Color x:Key="BgSurface">#FFFFFF</Color>
    <Color x:Key="BgSurfaceAlt">#EAF0F8</Color>
    <Color x:Key="BgGlow">#E5F8FF</Color>
    <Color x:Key="BorderSubtle">#D7E1EF</Color>
    <Color x:Key="TextPrimary">#101A2B</Color>
    <Color x:Key="TextMuted">#60718A</Color>
    <Color x:Key="TextOnAccent">#081321</Color>
    <Color x:Key="AccentPrimary">#007F9F</Color>
    <Color x:Key="AccentSecondary">#6D5CE7</Color>
    <Color x:Key="AccentDanger">#D83D5B</Color>
    <Color x:Key="AccentSuccess">#087F61</Color>
    <Color x:Key="AccentWarning">#956000</Color>
    <Color x:Key="OverlayScrim">#00000066</Color>

</ResourceDictionary>
